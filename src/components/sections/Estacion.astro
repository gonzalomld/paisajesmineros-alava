---
/**
 * Estación — escena 13: panel plum con la fotografía histórica de la
 * estación y el dibujo de su fachada; a la derecha, el centro contado
 * planta a planta.
 * IMÁGENES: foto histórica y dibujo de asfaltokia.eus (provisionales, en
 * baja resolución). Sustituir por fotografía actual del edificio.
 */
import { Image } from 'astro:assets';
import ButtonPill from '@/components/ui/ButtonPill.astro';
import { home } from '@/content/home';
import foto from '@/assets/photos/web-atauri-galeria-1.jpg';
import dibujo from '@/assets/brand/estacion-atauri-dibujo.png';
const { estacion } = home;
---
<section class="section theme-light estacion" data-bg="light" data-theme-trigger aria-labelledby="estacion-title">
  <div class="container">
    <div class="grid estacion__grid">
      <div class="col-4 estacion__panel theme-plum" data-reveal="ctn">
        <figure class="estacion__foto" data-parallax="w">
          <div data-parallax="img"><Image src={foto} alt="La estación de Atauri con los panes de asfalto apilados junto a la vía, fotografía histórica" widths={[480, 800]} sizes="(max-width: 991px) 100vw, 30vw" /></div>
        </figure>
        <Image class="estacion__dibujo" src={dibujo} alt="" width={350} height={362} aria-hidden="true" />
        <p class="l2 estacion__caption">Estación de Atauri · 1928</p>
      </div>
      <div class="col-5 start-6 estacion__body">
        <p class="l2 t-muted" data-reveal="p">{estacion.eyebrow}</p>
        <h2 id="estacion-title" class="h4 t-balance" data-reveal="line">{estacion.statement}</h2>
        <p class="p1 t-muted" data-reveal="line">{estacion.text}</p>
        <dl class="estacion__floors">
          {
            estacion.floors.map(([name, text]) => (
              <div data-reveal="p">
                <dt class="l1">{name}</dt>
                <dd class="p2 t-muted">{text}</dd>
              </div>
            ))
          }
        </dl>
        <p class="l1" data-reveal="p">{estacion.extra}</p>
        <div data-reveal="p"><ButtonPill label={estacion.cta.label} href={estacion.cta.href} /></div>
      </div>
    </div>
  </div>
</section>

<style>
  @layer components {
    .estacion {
      padding-block: var(--sp-120) var(--sp-192);
    }
    .estacion__grid {
      row-gap: var(--sp-48);
      align-items: start;
    }
    .estacion__panel {
      position: relative;
      padding: var(--sp-32);
      display: flex;
      flex-direction: column;
      gap: var(--sp-24);
    }
    .estacion__foto {
      aspect-ratio: 8 / 5;
      overflow: hidden;
    }
    .estacion__foto img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .estacion__dibujo {
      width: 60%;
      height: auto;
      align-self: flex-end;
      filter: invert(1);
      mix-blend-mode: screen;
      opacity: 0.8;
    }
    .estacion__caption {
      color: var(--fg-muted);
    }
    .estacion__body {
      display: flex;
      flex-direction: column;
      gap: var(--sp-24);
      padding-top: var(--sp-32);
    }
    .estacion__floors {
      display: flex;
      flex-direction: column;
      gap: var(--sp-16);
      margin: var(--sp-16) 0;
    }
    .estacion__floors div {
      display: grid;
      grid-template-columns: calc(var(--col) * 1.4) 1fr;
      gap: var(--sp-16);
      padding-top: var(--sp-12);
      border-top: var(--hairline) solid var(--line);
    }
    .estacion__floors dd {
      margin: 0;
    }
    @media (max-width: 991px) {
      .estacion {
        padding-block: var(--sp-96) var(--sp-120);
      }
      .estacion__floors div {
        grid-template-columns: 1fr;
        gap: var(--sp-6);
      }
    }
  }
</style>
