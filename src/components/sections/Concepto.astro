---
/**
 * Concepto — escena 05: la geología en una frase, centrada, con dos
 * cantos de roca (ui/Canto.astro) que derivan por las esquinas con el
 * scroll: el equivalente de las buganvillas de la referencia.
 */
import ArchMask from '@/components/ui/ArchMask.astro';
import Canto from '@/components/ui/Canto.astro';
import { home } from '@/content/home';
---
<section class="section theme-light concepto" data-bg="light" data-theme-trigger data-arch aria-labelledby="concepto-title">
  <ArchMask />
  <div class="container concepto__inner">
    <p id="concepto-title" class="l2 t-muted t-center" data-reveal="p">{home.concepto.eyebrow}</p>
    <p class="concepto__statement h4 t-center t-balance" data-reveal="line">{home.concepto.statement}</p>
    <p class="concepto__text p1 t-center" data-reveal="line">{home.concepto.text}</p>
    <Canto n={2} class="concepto__decor concepto__decor--l" attrs={{ 'data-drift': '', 'data-drift-y': '140', 'data-drift-x': '-30', 'data-drift-r': '10' }} />
    <Canto n={3} class="concepto__decor concepto__decor--r" attrs={{ 'data-drift': '', 'data-drift-y': '-120', 'data-drift-x': '40', 'data-drift-r': '-8' }} />
  </div>
</section>

<style>
  @layer components {
    .concepto {
      padding-block: var(--sp-192);
    }
    .concepto__inner {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--sp-32);
    }
    .concepto__statement {
      max-width: calc(var(--col) * 6 + var(--gap) * 5);
    }
    .concepto__text {
      max-width: calc(var(--col) * 4 + var(--gap) * 3);
      color: var(--fg-muted);
    }
    .concepto__decor {
      position: absolute;
      width: calc(var(--col) * 1.5 + var(--gap));
      pointer-events: none;
    }
    .concepto__decor--l {
      left: 0;
      top: calc(var(--sp-96) * -1);
    }
    .concepto__decor--r {
      right: 0;
      bottom: calc(var(--sp-120) * -1);
      width: calc(var(--col) * 1.5 + var(--gap));
    }
    @media (max-width: 991px) {
      .concepto {
        padding-block: var(--sp-120);
      }
      .concepto__decor {
        width: calc(var(--col) * 1.3);
      }
      .concepto__decor--l {
        left: calc(var(--margin) * -0.6);
        top: calc(var(--sp-64) * -1);
      }
      .concepto__decor--r {
        right: calc(var(--margin) * -0.6);
        bottom: calc(var(--sp-64) * -1);
        width: calc(var(--col) * 1.3);
      }
    }
  }
</style>
