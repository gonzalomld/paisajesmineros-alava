---
/**
 * Base — <html>, meta, fuentes, ClientRouter, Preloader, Header, Footer.
 * Un único <script> importa lifecycle.ts: se ejecuta una vez y sobrevive
 * a las navegaciones con View Transitions.
 */
import '@/styles/main.css';
import { ClientRouter } from 'astro:transitions';
import type { Theme } from '@/content/site';
import { site } from '@/content/site';
import Preloader from '@/components/global/Preloader.astro';
import Header from '@/components/global/Header.astro';
import Footer from '@/components/global/Footer.astro';
import PageTransition from '@/components/global/PageTransition.astro';
import RotateDevice from '@/components/global/RotateDevice.astro';
import ScrollProgress from '@/components/ui/ScrollProgress.astro';

interface Props {
  title: string;
  description?: string;
  /** Tema del header al cargar (la primera sección lo fija después por scroll) */
  headerTheme?: Theme;
  noindex?: boolean;
}

const { title, description = site.seo.description, headerTheme = 'light', noindex = false } = Astro.props;
const fullTitle = site.seo.titleTemplate.replace('%s', title);
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.brand.domain);

/* Fuentes: Google Fonts con display=swap. Las pilas de respaldo están en tokens.css. */
const fontsHref =
  'https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@112,400;112,500&family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500&family=Mrs+Saint+Delafield&display=swap';
---
<!doctype html>
<html lang={site.brand.lang} transition:name="root" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#340C24" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand.full} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />

    <!-- Arranque síncrono, antes del primer pintado: marca JS disponible,
         fija --vh-real y oculta el preloader si ya se vio en esta sesión. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        root.style.setProperty('--vh-real', window.innerHeight + 'px');
        try {
          if (sessionStorage.getItem('asfaltokia:visited')) root.classList.add('is-visited');
        } catch (e) {}
      })();
    </script>

    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link l1" href="#main">Saltar al contenido</a>

    <Preloader />
    <Header theme={headerTheme} />
    <ScrollProgress theme={headerTheme} />

    <div class="page">
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>

    <PageTransition />
    <RotateDevice />

    <div class="grid-overlay" data-grid-overlay aria-hidden="true">
      <div class="grid-overlay__rows"></div>
      <div class="grid-overlay__cols">
        {Array.from({ length: 10 }, () => <div class="grid-overlay__col" />)}
      </div>
    </div>

    <script>
      import '@/scripts/core/lifecycle';
    </script>
  </body>
</html>
