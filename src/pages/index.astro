---
/**
 * Home — Fase 02: el hero y las once escenas de contenido, en el orden del
 * storyboard. Cada sección declara su superficie (data-bg) para el header
 * y, cuando entra con arco, data-arch.
 */
import { getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/sections/Hero.astro';
import Puertas from '@/components/sections/Puertas.astro';
import Cita from '@/components/sections/Cita.astro';
import Concepto from '@/components/sections/Concepto.astro';
import Ubicacion from '@/components/sections/Ubicacion.astro';
import Llegar from '@/components/sections/Llegar.astro';
import MapaVivo from '@/components/sections/MapaVivo.astro';
import Experiencias from '@/components/sections/Experiencias.astro';
import Cifras from '@/components/sections/Cifras.astro';
import ArcoTexto from '@/components/sections/ArcoTexto.astro';
import Estacion from '@/components/sections/Estacion.astro';
import Cierre from '@/components/sections/Cierre.astro';
import { site } from '@/content/site';
import dayImg from '@/assets/photos/hero-cielo-abierto.jpg';

/* Precarga del LCP: el mismo srcset AVIF que genera <Picture> en el hero. */
const widths = [832, 1280, 1600, 2400];
const preload = await Promise.all(widths.map((width) => getImage({ src: dayImg, format: 'avif', width })));
const imagesrcset = preload.map((img) => `${img.src} ${img.attributes.width}w`).join(', ');
---
<Base title={site.brand.claim} headerTheme="dark">
  <Fragment slot="head">
    <link rel="preload" as="image" imagesrcset={imagesrcset} imagesizes="100vw" fetchpriority="high" />
  </Fragment>

  <Hero />
  <Puertas />
  <Cita />
  <Concepto />
  <Ubicacion />
  <Llegar />
  <MapaVivo />
  <Experiencias />
  <Cifras />
  <ArcoTexto />
  <Estacion />
  <Cierre />
</Base>
