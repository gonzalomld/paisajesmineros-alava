---
/**
 * /descubrir — placeholder de la Fase 01 para validar la transición de página.
 * El contenido (mapa vivo, Mina Lucía, ruta) llega en fases posteriores.
 */
import Base from '@/layouts/Base.astro';
import ArchMask from '@/components/ui/ArchMask.astro';
import ButtonPill from '@/components/ui/ButtonPill.astro';
import { site } from '@/content/site';
---
<Base title="Descubrir" description="Mina Lucía, Asfaltokia y la Ruta de los Asfaltos Naturales: qué ver en los paisajes mineros de Montaña Alavesa.">
  <section class="section theme-light page-intro vh" data-bg="light" data-theme-trigger aria-labelledby="descubrir-title">
    <div class="container">
      <p class="l2 t-muted" data-reveal="p" data-reveal-first>Página en construcción · Fase 02</p>
      <h1 id="descubrir-title" class="h2 page-intro__title" data-reveal="h" data-reveal-first>Descubrir</h1>
      <p class="page-intro__script a2" data-reveal="p" data-reveal-first data-reveal-delay="0.5" data-reveal-duration="0.6" aria-hidden="true">{site.brand.region}</p>
      <p class="p1 page-intro__text" data-reveal="line" data-reveal-first data-reveal-delay="0.6">
        Una ruta de 39 kilómetros une los centros de interpretación de Antoñana, el Parque Natural de Izki en Korres y
        Asfaltokia en Atauri. Aquí irá el mapa vivo con las rutas GPX y los puntos de interés.
      </p>
      <div data-reveal="p" data-reveal-first data-reveal-delay="0.8">
        <ButtonPill label="Volver al inicio" href="/" />
      </div>
    </div>
  </section>
  <section class="section theme-sky page-block vh" data-bg="sky" data-theme-trigger data-arch>
    <ArchMask />
    <div class="container">
      <h2 class="h4" data-reveal="h">Mina Lucía</h2>
      <p class="p1 page-block__text" data-reveal="line">Explotada desde 1872, con galerías donde el asfalto impregna la roca a la vista. Visitas guiadas los fines de semana y en Semana Santa y verano.</p>
    </div>
  </section>
</Base>

<style>
  @layer components {
    .page-intro {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-block: var(--sp-192) var(--sp-96);
    }
    .page-intro__title {
      margin-top: var(--sp-24);
    }
    .page-intro__script {
      margin-top: calc(var(--fs-a2) * -0.5);
      margin-left: var(--sp-96);
      position: relative;
      z-index: 1;
    }
    .page-intro__text {
      max-width: 48ch;
      margin-block: var(--sp-48) var(--sp-32);
    }
    .page-block {
      display: flex;
      align-items: center;
      padding-block: var(--sp-160);
    }
    .page-block__text {
      max-width: 44ch;
      margin-top: var(--sp-24);
    }
    @media (max-width: 991px) {
      .page-intro {
        padding-block: var(--sp-136) var(--sp-64);
      }
      .page-intro__script {
        margin-left: var(--sp-32);
      }
      .page-block {
        padding-block: var(--sp-96);
      }
    }
  }
</style>
